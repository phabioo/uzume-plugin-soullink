{
  "id": "uzume.soullink",
  "name": "SoulLink & Nuzlocke",
  "version": "0.9.1",
  "api": 1,
  "type": "script",
  "requires": { "uzume.soullink-core": ">=0.4.0" },
  "games": [
    { "system": "3ds", "codes": ["000400000011C400", "000400000011C500"] }
  ],
  "permissions": ["ui", "run.state", "video.capture"],
  "entry": "main.lua",
  "recap": [
    { "type": "soullink.catch", "glyph": "catch" },
    { "type": "soullink.death", "glyph": "lost" },
    { "type": "soullink.badge", "glyph": "badge" },
    { "type": "soullink.correction", "glyph": "note" }
  ],
  "run_settings": [
    { "key": "mode", "type": "enum", "label": "rs_mode", "default": "soullink",
      "options": [ { "value": "nuzlocke", "label": "rs_mode_nuzlocke" }, { "value": "soullink", "label": "rs_mode_soullink" } ] },
    { "key": "rules.first_encounter_only", "type": "boolean", "label": "rs_first_encounter_only", "hint": "rs_first_encounter_only_hint", "default": true },
    { "key": "rules.dupes_clause", "type": "boolean", "label": "rs_dupes_clause", "hint": "rs_dupes_clause_hint", "default": true },
    { "key": "rules.shiny_clause", "type": "boolean", "label": "rs_shiny_clause", "hint": "rs_shiny_clause_hint", "default": true },
    { "key": "rules.hordes_count", "type": "boolean", "label": "rs_hordes_count", "hint": "rs_hordes_count_hint", "default": false },
    { "key": "rules.pairs_differ_primary_type", "type": "boolean", "label": "rs_pairs_differ_primary_type", "hint": "rs_pairs_differ_primary_type_hint", "default": false },
    { "key": "rules.only_linked_in_team", "type": "boolean", "label": "rs_only_linked_in_team", "hint": "rs_only_linked_in_team_hint", "default": false },
    { "key": "rules.nickname_required", "type": "boolean", "label": "rs_nickname_required", "hint": "rs_nickname_required_hint", "default": true },
    { "key": "rules.level_caps", "type": "boolean", "label": "rs_level_caps", "hint": "rs_level_caps_hint", "default": true }
  ],
  "ui": {
    "panel": { "title": "SoulLink" },
    "hud": true,
    "tile": true,
    "screen": { "title": "SoulLink" },
    "run": { "title": "SoulLink" },
    "hotkeys": [
      { "id": "toggle-hud", "key": "Ctrl+H", "label": "Show or hide the SoulLink widget" },
      { "id": "doesnt-count", "key": "Ctrl+D", "label": "Encounter doesn't count" },
      { "id": "open-run", "key": "Ctrl+R", "label": "Open the run screen" }
    ]
  }
}
